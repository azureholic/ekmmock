<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test stack (xUnit v3 + Shouldly; no FluentAssertions, see spec section 3) -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <!-- In-process HTTP integration tests for the EKM API (M2). Matches the .NET 10.0.14 shared framework. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <!-- Console (M5). Fluent UI Blazor v4 on purpose (the repository's Fluent UI skill documents v4; v5 is a different component model), see DECISIONS.md. -->
    <PackageVersion Include="Microsoft.FluentUI.AspNetCore.Components" Version="4.14.5" />
    <PackageVersion Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="4.14.5" />
    <PackageVersion Include="Microsoft.Identity.Web" Version="4.18.0" />
    <!-- Console tests (M5): component tests and the real-browser smoke test. -->
    <PackageVersion Include="bunit" Version="2.14.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.64.1" />
    <!-- CLI (M8). System.CommandLine 2.0 is the stable release line; Azure.Identity is used only for the optional Entra device-code sign-in (DeviceCodeCredential, in-memory token cache). -->
    <PackageVersion Include="System.CommandLine" Version="2.0.14" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

</Project>
