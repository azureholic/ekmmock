# Files that run on Linux must have LF line endings in the repository and in every checkout, whatever the developer's Git settings
# (the rest of the repository keeps its existing line endings).
Makefile text eol=lf
*.sh text eol=lf
deploy/docker/Dockerfile text eol=lf
# The Azure deployment files run on Linux (cloud-init, the VM bootstrap script, e2e.sh) or are compiled by Bicep: LF only.
deploy/azure/** text eol=lf
