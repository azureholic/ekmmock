<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>EkmMock.Server</RootNamespace>
    <AssemblyName>EkmMock.Server</AssemblyName>
    <!--
      M5: reflection-based System.Text.Json has to be ON for the Blazor Server console: the framework itself deserializes its JavaScript-initializer manifest and the SignalR/Blazor
      circuit with the default resolver, and the host fails to start with the switch off. EkmMock's own JSON stays source-generated (every call passes a JsonTypeInfo from a
      JsonSerializerContext); an architecture test scans the sources so that reflection serialization cannot creep into our own code. See DECISIONS.md "M5: JSON".
    -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <!--
      M8 (benchmark, DECISIONS "M8: Benchmark"): Server GC, as spec 11.1 asks for the container image. At the load of spec 14 test 25 (about 30,000 requests/s) every exchange is retained in the inspector's ring buffer for
      a third of a second, so the heap promotes continuously; workstation GC paused 5 to 20 times per second for 10 to 300 ms (about 10 % of the time), Server GC (one heap per core, larger gen0 budget) makes the pauses rarer and shorter.
      Concurrent (background) GC stays on.
    -->
    <ServerGarbageCollector>true</ServerGarbageCollector>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" />
    <PackageReference Include="Microsoft.Identity.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EkmMock.Crypto\EkmMock.Crypto.csproj" />
    <ProjectReference Include="..\EkmMock.Pki\EkmMock.Pki.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EkmMock.Server.Tests" />
    <InternalsVisibleTo Include="EkmMock.Console.Tests" />
  </ItemGroup>

</Project>
